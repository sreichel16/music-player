{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music-player",
  "version": "0.1.0",
  "identifier": "cozy-music-player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
  "windows": [
  {
    "title": "music-player",
    "width": 380,
    "height": 380,
    "resizable": false,
    "decorations": false,
    "transparent": true
  }
],
   "security": {
  "csp": null,
  "dangerousDisableAssetCspModification": true
}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
